sql 
\f0\b \cf6 \strokec6 =
\f1\b0 \cf4 \strokec4  \cf7 \strokec7 f"""\cf4 \strokec4 \
\pard\pardeftab720\partightenfactor0
\cf7 \strokec7 WITH\cf4 \strokec4 \
\cf7 \strokec7 -- 1) Drug concept sets (RxNorm ingredient descendants)\cf4 \strokec4 \
\cf7 \strokec7 metformin_ingred AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT concept_id\cf4 \strokec4 \
\cf7 \strokec7   FROM `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept`\cf4 \strokec4 \
\cf7 \strokec7   WHERE vocabulary_id = 'RxNorm'\cf4 \strokec4 \
\cf7 \strokec7     AND concept_class_id = 'Ingredient'\cf4 \strokec4 \
\cf7 \strokec7     AND LOWER(concept_name) = 'metformin'\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\cf7 \strokec7 metformin_concepts AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT concept_id FROM metformin_ingred\cf4 \strokec4 \
\cf7 \strokec7   UNION DISTINCT\cf4 \strokec4 \
\cf7 \strokec7   SELECT ca.descendant_concept_id\cf4 \strokec4 \
\cf7 \strokec7   FROM `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept_ancestor` ca\cf4 \strokec4 \
\cf7 \strokec7   JOIN metformin_ingred mi\cf4 \strokec4 \
\cf7 \strokec7     ON ca.ancestor_concept_id = mi.concept_id\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 glp1_ingred AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT concept_id\cf4 \strokec4 \
\cf7 \strokec7   FROM `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept`\cf4 \strokec4 \
\cf7 \strokec7   WHERE vocabulary_id = 'RxNorm'\cf4 \strokec4 \
\cf7 \strokec7     AND concept_class_id = 'Ingredient'\cf4 \strokec4 \
\cf7 \strokec7     AND LOWER(concept_name) IN (\cf4 \strokec4 \
\cf7 \strokec7       'liraglutide',\cf4 \strokec4 \
\cf7 \strokec7       'semaglutide',\cf4 \strokec4 \
\cf7 \strokec7       'dulaglutide',\cf4 \strokec4 \
\cf7 \strokec7       'exenatide',\cf4 \strokec4 \
\cf7 \strokec7       'lixisenatide',\cf4 \strokec4 \
\cf7 \strokec7       'albiglutide',\cf4 \strokec4 \
\cf7 \strokec7       'tirzepatide'\cf4 \strokec4 \
\cf7 \strokec7     )\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\cf7 \strokec7 glp1_concepts AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT concept_id FROM glp1_ingred\cf4 \strokec4 \
\cf7 \strokec7   UNION DISTINCT\cf4 \strokec4 \
\cf7 \strokec7   SELECT ca.descendant_concept_id\cf4 \strokec4 \
\cf7 \strokec7   FROM `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept_ancestor` ca\cf4 \strokec4 \
\cf7 \strokec7   JOIN glp1_ingred gi\cf4 \strokec4 \
\cf7 \strokec7     ON ca.ancestor_concept_id = gi.concept_id\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 2) Degenerative spine condition concepts (keyword-based, standard)\cf4 \strokec4 \
\cf7 \strokec7 spine_condition_concepts AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT concept_id\cf4 \strokec4 \
\cf7 \strokec7   FROM `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept`\cf4 \strokec4 \
\cf7 \strokec7   WHERE domain_id = 'Condition'\cf4 \strokec4 \
\cf7 \strokec7     AND standard_concept = 'S'\cf4 \strokec4 \
\cf7 \strokec7     AND (\cf4 \strokec4 \
\cf7 \strokec7       LOWER(concept_name) LIKE '%spondylosis%'\cf4 \strokec4 \
\cf7 \strokec7       OR LOWER(concept_name) LIKE '%degenerative% spine%'\cf4 \strokec4 \
\cf7 \strokec7       OR LOWER(concept_name) LIKE '%degenerative disc%'\cf4 \strokec4 \
\cf7 \strokec7       OR LOWER(concept_name) LIKE '%intervertebral disc%degener%'\cf4 \strokec4 \
\cf7 \strokec7       OR LOWER(concept_name) LIKE '%osteoarthritis% spine%'\cf4 \strokec4 \
\cf7 \strokec7       OR LOWER(concept_name) LIKE '%spinal osteoarthritis%'\cf4 \strokec4 \
\cf7 \strokec7       OR LOWER(concept_name) LIKE '%spinal stenosis%'\cf4 \strokec4 \
\cf7 \strokec7     )\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 
\f5 \uc0\u9989 
\f1  BigQuery-safe: pre-filter condition_occurrence to spine-only via JOIN\cf4 \strokec4 \
\cf7 \strokec7 spine_co AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     co.person_id,\cf4 \strokec4 \
\cf7 \strokec7     co.condition_start_date\cf4 \strokec4 \
\cf7 \strokec7   FROM `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.condition_occurrence` co\cf4 \strokec4 \
\cf7 \strokec7   JOIN spine_condition_concepts scc\cf4 \strokec4 \
\cf7 \strokec7     ON co.condition_concept_id = scc.concept_id\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 3) First drug start dates\cf4 \strokec4 \
\cf7 \strokec7 drug_starts AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     de.person_id,\cf4 \strokec4 \
\cf7 \strokec7     MIN(IF(de.drug_concept_id IN (SELECT concept_id FROM metformin_concepts),\cf4 \strokec4 \
\cf7 \strokec7            de.drug_exposure_start_date, NULL)) AS metformin_start,\cf4 \strokec4 \
\cf7 \strokec7     MIN(IF(de.drug_concept_id IN (SELECT concept_id FROM glp1_concepts),\cf4 \strokec4 \
\cf7 \strokec7            de.drug_exposure_start_date, NULL)) AS glp1_start\cf4 \strokec4 \
\cf7 \strokec7   FROM `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.drug_exposure` de\cf4 \strokec4 \
\cf7 \strokec7   GROUP BY de.person_id\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 4) Exposure group + index_date\cf4 \strokec4 \
\cf7 \strokec7 cohort AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     person_id,\cf4 \strokec4 \
\cf7 \strokec7     CASE\cf4 \strokec4 \
\cf7 \strokec7       WHEN metformin_start IS NOT NULL AND glp1_start IS NULL THEN 'metformin_only'\cf4 \strokec4 \
\cf7 \strokec7       WHEN glp1_start IS NOT NULL AND metformin_start IS NULL THEN 'glp1_only'\cf4 \strokec4 \
\cf7 \strokec7       WHEN metformin_start IS NOT NULL AND glp1_start IS NOT NULL\cf4 \strokec4 \
\cf7 \strokec7            AND ABS(DATE_DIFF(metformin_start, glp1_start, DAY)) <= \{\cf4 \strokec4 COMBO_START_WINDOW_DAYS\cf7 \strokec7 \}\cf4 \strokec4 \
\cf7 \strokec7         THEN 'combo'\cf4 \strokec4 \
\cf7 \strokec7       ELSE NULL\cf4 \strokec4 \
\cf7 \strokec7     END AS exposure_group,\cf4 \strokec4 \
\cf7 \strokec7     CASE\cf4 \strokec4 \
\cf7 \strokec7       WHEN metformin_start IS NOT NULL AND glp1_start IS NULL THEN metformin_start\cf4 \strokec4 \
\cf7 \strokec7       WHEN glp1_start IS NOT NULL AND metformin_start IS NULL THEN glp1_start\cf4 \strokec4 \
\cf7 \strokec7       WHEN metformin_start IS NOT NULL AND glp1_start IS NOT NULL\cf4 \strokec4 \
\cf7 \strokec7            AND ABS(DATE_DIFF(metformin_start, glp1_start, DAY)) <= \{\cf4 \strokec4 COMBO_START_WINDOW_DAYS\cf7 \strokec7 \}\cf4 \strokec4 \
\cf7 \strokec7         THEN LEAST(metformin_start, glp1_start)\cf4 \strokec4 \
\cf7 \strokec7       ELSE NULL\cf4 \strokec4 \
\cf7 \strokec7     END AS index_date\cf4 \strokec4 \
\cf7 \strokec7   FROM drug_starts\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\cf7 \strokec7 cohort_clean AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT *\cf4 \strokec4 \
\cf7 \strokec7   FROM cohort\cf4 \strokec4 \
\cf7 \strokec7   WHERE exposure_group IS NOT NULL\cf4 \strokec4 \
\cf7 \strokec7     AND index_date IS NOT NULL\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 5) Observation period containing index_date + follow-up\cf4 \strokec4 \
\cf7 \strokec7 op AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     c.person_id,\cf4 \strokec4 \
\cf7 \strokec7     c.exposure_group,\cf4 \strokec4 \
\cf7 \strokec7     c.index_date,\cf4 \strokec4 \
\cf7 \strokec7     MAX(op.observation_period_end_date) AS op_end\cf4 \strokec4 \
\cf7 \strokec7   FROM cohort_clean c\cf4 \strokec4 \
\cf7 \strokec7   JOIN `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.observation_period` op\cf4 \strokec4 \
\cf7 \strokec7     ON op.person_id = c.person_id\cf4 \strokec4 \
\cf7 \strokec7    AND c.index_date BETWEEN op.observation_period_start_date AND op.observation_period_end_date\cf4 \strokec4 \
\cf7 \strokec7   GROUP BY c.person_id, c.exposure_group, c.index_date\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 6) Baseline BMI: closest within 365d pre-index, else within 30d post-index\cf4 \strokec4 \
\cf7 \strokec7 bmi_pre AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     o.person_id, o.index_date,\cf4 \strokec4 \
\cf7 \strokec7     m.value_as_number AS bmi_value,\cf4 \strokec4 \
\cf7 \strokec7     m.measurement_date AS bmi_date,\cf4 \strokec4 \
\cf7 \strokec7     ROW_NUMBER() OVER(\cf4 \strokec4 \
\cf7 \strokec7       PARTITION BY o.person_id, o.index_date\cf4 \strokec4 \
\cf7 \strokec7       ORDER BY DATE_DIFF(o.index_date, m.measurement_date, DAY) ASC\cf4 \strokec4 \
\cf7 \strokec7     ) AS rn\cf4 \strokec4 \
\cf7 \strokec7   FROM op o\cf4 \strokec4 \
\cf7 \strokec7   JOIN `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.measurement` m\cf4 \strokec4 \
\cf7 \strokec7     ON m.person_id = o.person_id\cf4 \strokec4 \
\cf7 \strokec7    AND m.measurement_concept_id = \{\cf4 \strokec4 BMI_CONCEPT_ID\cf7 \strokec7 \}\cf4 \strokec4 \
\cf7 \strokec7    AND m.value_as_number IS NOT NULL\cf4 \strokec4 \
\cf7 \strokec7    AND m.measurement_date <= o.index_date\cf4 \strokec4 \
\cf7 \strokec7    AND DATE_DIFF(o.index_date, m.measurement_date, DAY) <= 365\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\cf7 \strokec7 bmi_post AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     o.person_id, o.index_date,\cf4 \strokec4 \
\cf7 \strokec7     m.value_as_number AS bmi_value,\cf4 \strokec4 \
\cf7 \strokec7     m.measurement_date AS bmi_date,\cf4 \strokec4 \
\cf7 \strokec7     ROW_NUMBER() OVER(\cf4 \strokec4 \
\cf7 \strokec7       PARTITION BY o.person_id, o.index_date\cf4 \strokec4 \
\cf7 \strokec7       ORDER BY DATE_DIFF(m.measurement_date, o.index_date, DAY) ASC\cf4 \strokec4 \
\cf7 \strokec7     ) AS rn\cf4 \strokec4 \
\cf7 \strokec7   FROM op o\cf4 \strokec4 \
\cf7 \strokec7   JOIN `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.measurement` m\cf4 \strokec4 \
\cf7 \strokec7     ON m.person_id = o.person_id\cf4 \strokec4 \
\cf7 \strokec7    AND m.measurement_concept_id = \{\cf4 \strokec4 BMI_CONCEPT_ID\cf7 \strokec7 \}\cf4 \strokec4 \
\cf7 \strokec7    AND m.value_as_number IS NOT NULL\cf4 \strokec4 \
\cf7 \strokec7    AND m.measurement_date > o.index_date\cf4 \strokec4 \
\cf7 \strokec7    AND DATE_DIFF(m.measurement_date, o.index_date, DAY) <= 30\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\cf7 \strokec7 bmi_pick AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT person_id, index_date, bmi_value, bmi_date\cf4 \strokec4 \
\cf7 \strokec7   FROM bmi_pre\cf4 \strokec4 \
\cf7 \strokec7   WHERE rn = 1\cf4 \strokec4 \
\cf7 \strokec7   UNION ALL\cf4 \strokec4 \
\cf7 \strokec7   SELECT person_id, index_date, bmi_value, bmi_date\cf4 \strokec4 \
\cf7 \strokec7   FROM bmi_post\cf4 \strokec4 \
\cf7 \strokec7   WHERE rn = 1\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\cf7 \strokec7 bmi_final AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     person_id,\cf4 \strokec4 \
\cf7 \strokec7     index_date,\cf4 \strokec4 \
\cf7 \strokec7     ANY_VALUE(bmi_value) AS bmi\cf4 \strokec4 \
\cf7 \strokec7   FROM (\cf4 \strokec4 \
\cf7 \strokec7     SELECT\cf4 \strokec4 \
\cf7 \strokec7       person_id, index_date, bmi_value, bmi_date,\cf4 \strokec4 \
\cf7 \strokec7       ROW_NUMBER() OVER(PARTITION BY person_id, index_date ORDER BY bmi_date ASC) AS pick_rn\cf4 \strokec4 \
\cf7 \strokec7     FROM bmi_pick\cf4 \strokec4 \
\cf7 \strokec7   )\cf4 \strokec4 \
\cf7 \strokec7   WHERE pick_rn = 1\cf4 \strokec4 \
\cf7 \strokec7   GROUP BY person_id, index_date\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 7) Spine dx timing\cf4 \strokec4 \
\cf7 \strokec7 -- FIXES:\cf4 \strokec4 \
\cf7 \strokec7 --   - prevalent/same-day: any dx_date <= index_date (exclude those people)\cf4 \strokec4 \
\cf7 \strokec7 --   - incident: dx_date > index_date AND <= index_date + 730\cf4 \strokec4 \
\cf7 \strokec7 spine_dx AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     o.person_id,\cf4 \strokec4 \
\cf7 \strokec7     o.index_date,\cf4 \strokec4 \
\cf7 \strokec7     MIN(sc.condition_start_date) AS first_spine_dx_any,\cf4 \strokec4 \
\cf7 \strokec7     MIN(IF(sc.condition_start_date <= o.index_date, sc.condition_start_date, NULL)) AS spine_dx_on_or_before_index,\cf4 \strokec4 \
\cf7 \strokec7     MIN(IF(sc.condition_start_date > o.index_date\cf4 \strokec4 \
\cf7 \strokec7             AND sc.condition_start_date <= DATE_ADD(o.index_date, INTERVAL \{\cf4 \strokec4 WINDOW_DAYS\cf7 \strokec7 \} DAY),\cf4 \strokec4 \
\cf7 \strokec7             sc.condition_start_date, NULL)) AS first_spine_dx_in_window\cf4 \strokec4 \
\cf7 \strokec7   FROM op o\cf4 \strokec4 \
\cf7 \strokec7   LEFT JOIN spine_co sc\cf4 \strokec4 \
\cf7 \strokec7     ON sc.person_id = o.person_id\cf4 \strokec4 \
\cf7 \strokec7   GROUP BY o.person_id, o.index_date\cf4 \strokec4 \
\cf7 \strokec7 ),\cf4 \strokec4 \
\
\cf7 \strokec7 -- 8) Final analytic dataset\cf4 \strokec4 \
\cf7 \strokec7 final AS (\cf4 \strokec4 \
\cf7 \strokec7   SELECT\cf4 \strokec4 \
\cf7 \strokec7     o.person_id,\cf4 \strokec4 \
\cf7 \strokec7     o.exposure_group,\cf4 \strokec4 \
\cf7 \strokec7     o.index_date,\cf4 \strokec4 \
\cf7 \strokec7     DATE_DIFF(o.op_end, o.index_date, DAY) AS days_followup,\cf4 \strokec4 \
\cf7 \strokec7     DATE(p.birth_datetime) AS dob,\cf4 \strokec4 \
\cf7 \strokec7     SAFE_DIVIDE(DATE_DIFF(o.index_date, DATE(p.birth_datetime), DAY), 365.25) AS age_at_index,\cf4 \strokec4 \
\cf7 \strokec7     sex.concept_name AS sex_at_birth,\cf4 \strokec4 \
\cf7 \strokec7     race.concept_name AS race,\cf4 \strokec4 \
\cf7 \strokec7     eth.concept_name AS ethnicity,\cf4 \strokec4 \
\cf7 \strokec7     b.bmi,\cf4 \strokec4 \
\cf7 \strokec7     IF(b.bmi >= 30, 1, 0) AS obese_bmi30,\cf4 \strokec4 \
\cf7 \strokec7     IF(sd.first_spine_dx_in_window IS NOT NULL, 1, 0) AS incident_degenerative_spine_dx,\cf4 \strokec4 \
\cf7 \strokec7     sd.first_spine_dx_in_window AS first_spine_dx_date\cf4 \strokec4 \
\cf7 \strokec7   FROM op o\cf4 \strokec4 \
\cf7 \strokec7   JOIN `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.person` p\cf4 \strokec4 \
\cf7 \strokec7     ON p.person_id = o.person_id\cf4 \strokec4 \
\cf7 \strokec7   LEFT JOIN `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept` sex\cf4 \strokec4 \
\cf7 \strokec7     ON sex.concept_id = p.sex_at_birth_concept_id\cf4 \strokec4 \
\cf7 \strokec7   LEFT JOIN `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept` race\cf4 \strokec4 \
\cf7 \strokec7     ON race.concept_id = p.race_concept_id\cf4 \strokec4 \
\cf7 \strokec7   LEFT JOIN `\{\cf4 \strokec4 DATASET\cf7 \strokec7 \}.concept` eth\cf4 \strokec4 \
\cf7 \strokec7     ON eth.concept_id = p.ethnicity_concept_id\cf4 \strokec4 \
\cf7 \strokec7   LEFT JOIN bmi_final b\cf4 \strokec4 \
\cf7 \strokec7     ON b.person_id = o.person_id AND b.index_date = o.index_date\cf4 \strokec4 \
\cf7 \strokec7   LEFT JOIN spine_dx sd\cf4 \strokec4 \
\cf7 \strokec7     ON sd.person_id = o.person_id AND sd.index_date = o.index_date\cf4 \strokec4 \
\cf7 \strokec7   WHERE DATE_DIFF(o.op_end, o.index_date, DAY) >= \{\cf4 \strokec4 MIN_FOLLOWUP_DAYS\cf7 \strokec7 \}\cf4 \strokec4 \
\cf7 \strokec7     AND sd.spine_dx_on_or_before_index IS NULL   -- FIX #1: exclude prevalent/same-day\cf4 \strokec4 \
\cf7 \strokec7 )\cf4 \strokec4 \
\
\cf7 \strokec7 SELECT *\cf4 \strokec4 \
\cf7 \strokec7 FROM final\cf4 \strokec4 \
\cf7 \strokec7 """\cf4 \strokec4 \
\
\pard\pardeftab720\partightenfactor0

